APP_TITLE=AHD Matematik ve Kodlama Semineri
APP_HOST=127.0.0.1
APP_PORT=8081
DB_PATH=data/seminer.db
WEATHER_URL=https://api.open-meteo.com/v1/forecast?latitude=36.2026&longitude=36.1604&current=temperature_2m,weather_code&timezone=Europe/Istanbul

# SMTP — şifre sıfırlama postası. Gerçek parolayı kaynağa yazmayın.
# Gmail için uygulama şifresi kullanın (hesap şifresi değil).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# SMTP_FROM bir e-posta adresi olmalı (görünen ad değil). Boşsa USERNAME kullanılır.
SMTP_FROM=
