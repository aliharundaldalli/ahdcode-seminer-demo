// AHD Matematik ve Kodlama Semineri
// AhdCode v0.10.0: Argon2id şifre, CSRF, SMTP ile şifre sıfırlama,
// uzantısız saklanan PDF/metin özetlerinin HTTP.download ile indirilmesi.

bring Env
from Env bring EnvError
bring File
bring Path
bring HTTP
from HTTP bring Server
from HTTP bring Request
from HTTP bring Response
from HTTP bring SessionStore
from HTTP bring Session
from HTTP bring Client
from HTTP bring ClientResponse
from HTTP bring HTTPError
from HTTP bring UploadedFile
bring HTML
from HTML bring HTMLNode
bring JSON
from JSON bring JSONValue
from JSON bring JSONError
bring SQLite
from SQLite bring Database
from SQLite bring SQLiteValue
from SQLite bring SQLiteError
bring Security
from Security bring SecurityError
bring Latex
from Latex bring LatexError
bring SMTP
from SMTP bring SMTPClient
from SMTP bring SMTPMessage
from SMTP bring SMTPError

attempt {
    Env.load(".env", true)
} except EnvError as error {
    write("Uyarı: .env okunamadı ({error.message}). Varsayılan değerler kullanılacak.")
}

appTitle: String := Env.getOr("APP_TITLE", "AHD Matematik ve Kodlama Semineri")
appHost: String := Env.getOr("APP_HOST", "127.0.0.1")
appPort: Int := int(Env.getOr("APP_PORT", "8081"))
dbPath: String := Env.getOr("DB_PATH", "data/seminer.db")
uploadDir: String := "data/ozetler"
certDir: String := "data/sertifikalar"
weatherUrl: String := Env.getOr(
    "WEATHER_URL"
    "https://api.open-meteo.com/v1/forecast?latitude=36.2026&longitude=36.1604&current=temperature_2m,weather_code&timezone=Europe/Istanbul"
)
smtpHost: String := Env.getOr("SMTP_HOST", "")
smtpPort: Int := int(Env.getOr("SMTP_PORT", "587"))
smtpSecurity: String := Env.getOr("SMTP_SECURITY", "starttls")
smtpUsername: String := Env.getOr("SMTP_USERNAME", "")
smtpPassword: String := Env.getOr("SMTP_PASSWORD", "")
smtpFrom: String := Env.getOr("SMTP_FROM", "")
httpClient: Client := HTTP.client(8)
sessions: SessionStore := HTTP.sessions(
    "ahd_session"
    3600
    false
    "Lax"
)

ensureDir: Function := (folder: String) -> Nothing {
    if folder != "" {
        if folder != "." {
            if File.exists(folder) == false {
                File.createDir(folder)
            }
        }
    }
}

openDb: Function := () -> Database {
    dbPath: Global String
    ensureDir(Path.dir(dbPath))
    db: Local Database := SQLite.open(dbPath)
    attempt {
        db.query("SELECT username, email, password_hash FROM users LIMIT 1")
    } except SQLiteError as error {
        db.execute("DROP TABLE IF EXISTS users")
        db.execute("DROP TABLE IF EXISTS messages")
    }
    db.execute("""
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT NOT NULL UNIQUE,
            email TEXT NOT NULL UNIQUE,
            password_hash TEXT NOT NULL
        )
        """)
    db.execute("""
        CREATE TABLE IF NOT EXISTS summaries (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER NOT NULL UNIQUE,
            title TEXT NOT NULL,
            stored_path TEXT NOT NULL,
            content_type TEXT NOT NULL,
            download_name TEXT NOT NULL
        )
        """)
    attempt {
        db.query("SELECT token_hash FROM password_resets LIMIT 1")
    } except SQLiteError as error {
        db.execute("DROP TABLE IF EXISTS password_resets")
    }
    db.execute("""
        CREATE TABLE IF NOT EXISTS password_resets (
            user_id INTEGER NOT NULL UNIQUE,
            token_hash TEXT NOT NULL
        )
        """)
    db.execute("DROP TABLE IF EXISTS session")
    return db
}

csrfToken: Function := (session: Session) -> String {
    token: Local String? := session.get("csrf")
    if token == null {
        token = Security.token()
        session.set("csrf", token)
    }
    return token
}

csrfInput: Function := (session: Session) -> HTMLNode {
    token: Local String := csrfToken(session)
    return HTML.element("input", {"type": "hidden", "name": "csrf", "value": token}, [])
}

csrfOk: Function := (session: Session, request: Request) -> Bool {
    expected: Local String? := session.get("csrf")
    received: Local String? := request.form("csrf")
    if expected == null {
        return false
    }
    if received == null {
        return false
    }
    return Security.secureEqual(expected, received)
}

rotateCsrf: Function := (session: Session) -> Nothing {
    session.set("csrf", Security.token())
}

loggedId: Function := (session: Session) -> Int? {
    raw: Local String? := session.get("user_id")
    if raw == null {
        return null
    }
    return int(raw)
}

loggedName: Function := (db: Database, session: Session) -> String? {
    userId: Local Int? := loggedId(session)
    if userId == null {
        return null
    }
    rows: Local List<Pair<String, SQLiteValue>> := db.query(
        "SELECT username FROM users WHERE id = ?"
        [SQLite.fromInt(userId)]
    )
    if len(rows) == 0 {
        return null
    }
    return rows[0]["username"].string()
}

weatherLabel: Function := (code: Int) -> String {
    if code == 0 {
        return "açık"
    }
    if code <= 3 {
        return "parçalı bulutlu"
    }
    if code <= 48 {
        return "sisli"
    }
    if code <= 67 {
        return "yağmurlu"
    }
    if code <= 77 {
        return "karlı"
    }
    if code <= 82 {
        return "sağanak"
    }
    if code <= 99 {
        return "gök gürültülü"
    }
    return "değişken"
}

weatherUnavailable: Function := (detail: String) -> HTMLNode {
    return HTML.element(
        "article"
        {"class": "card"}
        [
            HTML.element("p", {"class": "day"}, [HTML.text("Hatay hava")])
            HTML.element("h3", {}, [HTML.text("Şu an alınamadı")])
            HTML.element("p", {"class": "muted"}, [HTML.text(detail)])
        ]
    )
}

weatherCard: Function := () -> HTMLNode {
    httpClient: Global Client
    weatherUrl: Global String
    attempt {
        response: Local ClientResponse := httpClient.get(weatherUrl)
        if response.status() >= 400 {
            return weatherUnavailable("API durumu {str(response.status())}")
        }
        parsed: Local JSONValue := JSON.parse(response.body())
        current: Local JSONValue? := parsed.get("current")
        if current == null {
            return weatherUnavailable("Yanıtta current yok")
        }
        tempVal: Local JSONValue? := current.get("temperature_2m")
        codeVal: Local JSONValue? := current.get("weather_code")
        if tempVal == null {
            return weatherUnavailable("Sıcaklık yok")
        }
        if codeVal == null {
            return weatherUnavailable("Kod yok")
        }
        temp: Local String := str(tempVal.real())
        label: Local String := weatherLabel(codeVal.int())
        return HTML.element(
            "article"
            {"class": "card"}
            [
                HTML.element("p", {"class": "day"}, [HTML.text("Hatay hava")])
                HTML.element("h3", {}, [HTML.text("{temp} °C")])
                HTML.element("p", {}, [HTML.text("Antakya · {label}")])
                HTML.element("p", {"class": "muted"}, [HTML.text("Open-Meteo · HTTP Client")])
            ]
        )
    } except HTTPError as error {
        return weatherUnavailable(error.message)
    } except JSONError as error {
        return weatherUnavailable(error.message)
    }
}

htmlPage: Function := (pageTitle: String, inner: HTMLNode, status: Int) -> Response {
    start: Local String := r"""<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>"""
    middle: Local String := r"""</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root {
    --navy: #122033;
    --navy-mid: #1a2f4a;
    --gold: #c9b27a;
    --gold-deep: #8a7348;
    --paper: #f6f4f0;
    --ink: #1c2430;
    --muted: #5a6573;
    --line: #d8d2c8;
    --card: #fff;
    --ok: #1e4d3a;
    --err: #8b2e2e;
}
* { box-sizing: border-box; }
body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    color: var(--ink);
    background:
        radial-gradient(circle at top right, rgba(201, 178, 122, 0.18), transparent 36%),
        var(--paper);
    font-family: "Source Sans 3", "Segoe UI", sans-serif;
    line-height: 1.6;
}
a { color: var(--navy-mid); }
.topbar {
    background: var(--navy);
    color: #f3efe7;
    border-bottom: 3px solid var(--gold);
    position: sticky;
    top: 0;
    z-index: 20;
}
.topbar-inner, .wrap, .footer-inner {
    width: min(1080px, calc(100% - 2rem));
    margin: 0 auto;
}
.topbar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 72px;
    flex-wrap: wrap;
    padding: 0.6rem 0;
}
.brand {
    color: #f3efe7;
    text-decoration: none;
}
.brand strong {
    display: block;
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: 1.05rem;
}
.brand span {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.75;
}
.nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.1rem;
    align-items: center;
}
.nav a, .nav button {
    color: #e8e2d6;
    background: none;
    border: 0;
    font: inherit;
    cursor: pointer;
    text-decoration: none;
}
.nav a:hover, .nav button:hover { color: #fff; }
.hero {
    background:
        linear-gradient(180deg, rgba(18, 32, 51, 0.92), rgba(18, 32, 51, 0.82)),
        linear-gradient(135deg, #1a2f4a 0%, #1e4d3a 100%);
    color: #f7f3ec;
    padding: 4.2rem 0 3.6rem;
}
.kicker {
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-size: 0.76rem;
    color: var(--gold);
    margin: 0 0 0.8rem;
}
.hero h1 {
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: clamp(1.7rem, 4vw, 2.7rem);
    line-height: 1.25;
    margin: 0 0 0.8rem;
    max-width: 16ch;
}
.hero p { max-width: 40rem; color: #e4ddd0; }
.meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.4rem;
    margin: 1.4rem 0 1.8rem;
}
.actions { display: flex; flex-wrap: wrap; gap: 0.7rem; }
.btn {
    display: inline-block;
    background: var(--gold);
    color: var(--navy);
    text-decoration: none;
    border: 0;
    padding: 0.75rem 1.2rem;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
}
.btn.ghost {
    background: transparent;
    color: #f7f3ec;
    outline: 1px solid rgba(247, 243, 236, 0.45);
}
.btn.navy {
    background: var(--navy-mid);
    color: #f7f3ec;
}
main { flex: 1; padding: 2.4rem 0 3rem; }
h2, h3 { font-family: "Libre Baskerville", Georgia, serif; }
.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
}
.card {
    background: var(--card);
    border: 1px solid var(--line);
    box-shadow: 0 8px 24px rgba(18, 32, 51, 0.06);
    padding: 1.15rem 1.2rem;
}
.card .day {
    color: var(--gold-deep);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 0.35rem;
}
.list {
    list-style: none;
    padding: 0;
    margin: 0;
}
.list li {
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
}
form.stack label { display: block; margin: 0.85rem 0 0.3rem; font-weight: 600; }
input, textarea {
    width: 100%;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--line);
    font: inherit;
    background: #fff;
}
textarea { min-height: 140px; resize: vertical; }
.notice {
    background: #f8e7dc;
    border: 1px solid #e2c4b0;
    padding: 0.9rem 1rem;
    margin-bottom: 1rem;
}
.ok {
    background: #e8f0ec;
    border: 1px solid #b7d0c2;
    padding: 0.9rem 1rem;
    margin-bottom: 1rem;
}
.split { display: grid; gap: 1.4rem; }
@media (min-width: 860px) {
    .split { grid-template-columns: 1.1fr 0.9fr; align-items: start; }
}
.muted { color: var(--muted); }
footer {
    background: var(--navy);
    color: #eadccb;
    padding: 1.1rem 0;
    font-size: 0.92rem;
}
footer a { color: #f3e6d4; }
</style>
</head>
<body>
"""
    ending: Local String := r"""
</body>
</html>"""
    markup: Local String := start + HTML.render(HTML.text(pageTitle)) + middle + HTML.render(inner) + ending
    return HTTP.html(markup, status)
}

siteFooter: Function := () -> HTMLNode {
    return HTML.element(
        "footer"
        {}
        [
            HTML.element(
                "div"
                {"class": "footer-inner"}
                [
                    HTML.text("Hatay · 27–30 Eylül 2026 · AhdCode v0.10.0 yerel demo")
                ]
            )
        ]
    )
}

appChrome: Function := (session: Session, userName: String?, content: HTMLNode) -> HTMLNode {
    appTitle: Global String
    links: Local List<HTMLNode> := [
        HTML.element("a", {"href": "/"}, [HTML.text("Ana sayfa")])
    ]
    if userName == null {
        links.add(HTML.element("a", {"href": "/kayit"}, [HTML.text("Kayıt ol")]))
        links.add(HTML.element("a", {"href": "/giris"}, [HTML.text("Giriş yap")]))
    }
    else {
        links.add(HTML.element("a", {"href": "/panel"}, [HTML.text("Panel")]))
        links.add(
            HTML.element(
                "form"
                {"method": "post", "action": "/cikis", "style": "margin:0"}
                [
                    csrfInput(session)
                    HTML.element("button", {"type": "submit"}, [HTML.text("Çıkış")])
                ]
            )
        )
    }
    return HTML.element(
        "div"
        {"style": "min-height:100vh;display:flex;flex-direction:column"}
        [
            HTML.element(
                "header"
                {"class": "topbar"}
                [
                    HTML.element(
                        "div"
                        {"class": "topbar-inner"}
                        [
                            HTML.element(
                                "a"
                                {"class": "brand", "href": "/"}
                                [
                                    HTML.element("strong", {}, [HTML.text(appTitle)])
                                    HTML.element("span", {}, [HTML.text("Hatay 2026")])
                                ]
                            )
                            HTML.element("nav", {"class": "nav"}, links)
                        ]
                    )
                ]
            )
            content
            siteFooter()
        ]
    )
}

noticePage: Function := (session: Session, text: String, status: Int) -> Response {
    appTitle: Global String
    db: Local Database := openDb()
    userName: Local String? := loggedName(db, session)
    db.close()
    content: Local HTMLNode := HTML.element(
        "main"
        {}
        [
            HTML.element(
                "div"
                {"class": "wrap"}
                [
                    HTML.element("div", {"class": "notice"}, [HTML.text(text)])
                    HTML.element("a", {"href": "/"}, [HTML.text("Ana sayfaya dön")])
                ]
            )
        ]
    )
    return htmlPage(appTitle, appChrome(session, userName, content), status)
}

sendResetMail: Function := (toAddress: String, resetToken: String) -> String {
    smtpHost: Global String
    smtpPort: Global Int
    smtpSecurity: Global String
    smtpUsername: Global String
    smtpPassword: Global String
    smtpFrom: Global String
    appHost: Global String
    appPort: Global Int
    if smtpHost == "" {
        return "SMTP_HOST .env içinde boş. Posta gönderilmedi."
    }
    if smtpUsername == "" {
        return "SMTP_USERNAME .env içinde boş. E-posta kullanıcı adınızı yazın."
    }
    if smtpPassword == "" {
        return "SMTP_PASSWORD .env içinde boş. Gmail için uygulama şifresi yazın."
    }
    fromAddress: Local String := smtpUsername
    if smtpFrom != "" {
        fromAddress = smtpFrom
    }
    resetLink: Local String := "http://{appHost}:{str(appPort)}/sifre-sifirla?token={resetToken}"
    attempt {
        client: Local SMTPClient := SMTP.client(smtpHost, smtpPort, smtpSecurity)
        client = client.withPlainAuth(smtpUsername, smtpPassword)
        message: Local SMTPMessage := SMTP.message(
            fromAddress
            [toAddress]
            "AHD Seminer şifre sıfırlama"
        )
        message = message.withText("Şifrenizi sıfırlamak için bu bağlantıyı açın: {resetLink}")
        client.send(message)
        return "ok"
    } except SMTPError as error {
        return error.message
    }
}

home: Function := (request: Request) -> Response {
    appTitle: Global String
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    db: Local Database := openDb()
    userName: Local String? := loggedName(db, session)
    people: Local List<Pair<String, SQLiteValue>> := db.query("""
        SELECT summaries.id AS id, users.username AS username, summaries.title AS title
        FROM summaries
        JOIN users ON users.id = summaries.user_id
        ORDER BY users.username
        """)
    db.close()

    names: Local List<HTMLNode> := []
    if len(people) == 0 {
        names.add(HTML.element("p", {"class": "muted"}, [HTML.text("Henüz indirilebilir özet yok.")]))
    }
    else {
        items: Local List<HTMLNode> := []
        for row in people {
            itemId: Local String := str(row["id"].int())
            items.add(
                HTML.element(
                    "li"
                    {}
                    [
                        HTML.text(row["username"].string())
                        HTML.text(" — ")
                        HTML.text(row["title"].string())
                        HTML.text(" · ")
                        HTML.element("a", {"href": "/ozet?id={itemId}"}, [HTML.text("İndir")])
                    ]
                )
            )
        }
        names.add(HTML.element("ul", {"class": "list"}, items))
    }

    heroButtons: Local List<HTMLNode> := [
        HTML.element("a", {"class": "btn", "href": "/kayit"}, [HTML.text("Kayıt ol")])
        HTML.element("a", {"class": "btn ghost", "href": "/giris"}, [HTML.text("Giriş yap")])
    ]
    if userName != null {
        heroButtons = [
            HTML.element("a", {"class": "btn", "href": "/panel"}, [HTML.text("Panele git")])
        ]
    }

    hero: Local HTMLNode := HTML.element(
        "section"
        {"class": "hero"}
        [
            HTML.element(
                "div"
                {"class": "wrap"}
                [
                    HTML.element("p", {"class": "kicker"}, [HTML.text("AHD Akademi")])
                    HTML.element("h1", {}, [HTML.text(appTitle)])
                    HTML.element(
                        "p"
                        {}
                        [HTML.text("Hatay’da dört gün: matematik oturumları, kodlama atölyeleri ve yerel bir seminer defteri.")]
                    )
                    HTML.element(
                        "div"
                        {"class": "meta"}
                        [
                            HTML.element("span", {}, [HTML.text("27–30 Eylül 2026")])
                            HTML.element("span", {}, [HTML.text("Hatay, Türkiye")])
                            HTML.element("span", {}, [HTML.text("Mustafa Kemal Üniversitesi")])
                        ]
                    )
                    HTML.element("div", {"class": "actions"}, heroButtons)
                ]
            )
        ]
    )

    body: Local HTMLNode := HTML.element(
        "main"
        {}
        [
            HTML.element(
                "div"
                {"class": "wrap split"}
                [
                    HTML.element(
                        "section"
                        {}
                        [
                            HTML.element("h2", {}, [HTML.text("Program")])
                            HTML.element(
                                "div"
                                {"class": "grid"}
                                [
                                    HTML.element(
                                        "article"
                                        {"class": "card"}
                                        [
                                            HTML.element("p", {"class": "day"}, [HTML.text("27 Eylül Pazar")])
                                            HTML.element("h3", {}, [HTML.text("Açılış")])
                                            HTML.element("p", {}, [HTML.text("Hatay’da karşılama, seminer düzeni ve kodlama masalarının tanıtımı.")])
                                        ]
                                    )
                                    HTML.element(
                                        "article"
                                        {"class": "card"}
                                        [
                                            HTML.element("p", {"class": "day"}, [HTML.text("28 Eylül Pazartesi")])
                                            HTML.element("h3", {}, [HTML.text("Matematik")])
                                            HTML.element("p", {}, [HTML.text("Sayılar, ispat ve sınıf içi problem çözme oturumları.")])
                                        ]
                                    )
                                    HTML.element(
                                        "article"
                                        {"class": "card"}
                                        [
                                            HTML.element("p", {"class": "day"}, [HTML.text("29 Eylül Salı")])
                                            HTML.element("h3", {}, [HTML.text("Kodlama")])
                                            HTML.element("p", {}, [HTML.text("AhdCode ile küçük programlar; panele özet bırakma.")])
                                        ]
                                    )
                                    HTML.element(
                                        "article"
                                        {"class": "card"}
                                        [
                                            HTML.element("p", {"class": "day"}, [HTML.text("30 Eylül Çarşamba")])
                                            HTML.element("h3", {}, [HTML.text("Kapanış")])
                                            HTML.element("p", {}, [HTML.text("Atölye özeti, listeye düşen isimler ve Hatay’dan veda.")])
                                        ]
                                    )
                                ]
                            )
                        ]
                    )
                    HTML.element(
                        "section"
                        {}
                        [
                            HTML.element("h2", {}, [HTML.text("Hatay hava")])
                            HTML.element("p", {"class": "muted"}, [HTML.text("Ana sayfa her açılışta HTTPS ile Open-Meteo’dan güncel sıcaklığı alır.")])
                            weatherCard()
                            HTML.element("h2", {}, [HTML.text("Özet listesi")])
                            HTML.element("p", {"class": "muted"}, [HTML.text("Giriş yaptıktan sonra özet gönderen her kullanıcı adı burada bir kez görünür. Özetler indirilebilir.")])
                            HTML.element("div", {"class": "card"}, names)
                        ]
                    )
                ]
            )
        ]
    )

    page: Local HTMLNode := HTML.element("div", {}, [hero, body])
    return sessions.commit(session, htmlPage(appTitle, appChrome(session, userName, page), 200))
}

registerPage: Function := (request: Request) -> Response {
    appTitle: Global String
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    db: Local Database := openDb()
    userName: Local String? := loggedName(db, session)
    db.close()
    if userName != null {
        return sessions.commit(session, HTTP.redirect("/panel"))
    }
    content: Local HTMLNode := HTML.element(
        "main"
        {}
        [
            HTML.element(
                "div"
                {"class": "wrap"}
                [
                    HTML.element("p", {"class": "kicker"}, [HTML.text("Katılım")])
                    HTML.element("h2", {}, [HTML.text("Kayıt ol")])
                    HTML.element("p", {"class": "muted"}, [HTML.text("Kullanıcı adı ve şifre ile kayıt olun. Giriş ayrı sayfadadır.")])
                    HTML.element(
                        "section"
                        {"class": "card"}
                        [
                            HTML.element(
                                "form"
                                {"class": "stack", "method": "post", "action": "/kayit"}
                                [
                                    csrfInput(session)
                                    HTML.element("label", {}, [HTML.text("Kullanıcı adı")])
                                    HTML.element("input", {"type": "text", "name": "username", "required": "required", "autocomplete": "username"}, [])
                                    HTML.element("label", {}, [HTML.text("E-posta")])
                                    HTML.element("input", {"type": "email", "name": "email", "required": "required", "autocomplete": "email"}, [])
                                    HTML.element("label", {}, [HTML.text("Şifre")])
                                    HTML.element("input", {"type": "password", "name": "password", "required": "required", "autocomplete": "new-password"}, [])
                                    HTML.element("p", {}, [HTML.element("button", {"class": "btn navy", "type": "submit"}, [HTML.text("Kayıt ol")])])
                                ]
                            )
                        ]
                    )
                    HTML.element("p", {"class": "muted"}, [HTML.element("a", {"href": "/giris"}, [HTML.text("Zaten kayıtlıysanız giriş yapın")])])
                ]
            )
        ]
    )
    return sessions.commit(session, htmlPage(appTitle, appChrome(session, userName, content), 200))
}

