panelPage: Function := (request: Request) -> Response {
    appTitle: Global String
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    db: Local Database := openDb()
    userName: Local String? := loggedName(db, session)
    userId: Local Int? := loggedId(session)
    if userName == null {
        db.close()
        return sessions.commit(session, HTTP.redirect("/giris"))
    }
    if userId == null {
        db.close()
        return sessions.commit(session, HTTP.redirect("/giris"))
    }
    existing: Local List<Pair<String, SQLiteValue>> := db.query(
        "SELECT id, title, download_name FROM summaries WHERE user_id = ?"
        [SQLite.fromInt(userId)]
    )
    db.close()

    formOrNote: Local HTMLNode := HTML.element(
        "form"
        {
            "class": "stack"
            "method": "post"
            "action": "/ozet"
            "enctype": "multipart/form-data"
        }
        [
            csrfInput(session)
            HTML.element("label", {}, [HTML.text("Özet adı")])
            HTML.element("input", {"type": "text", "name": "title", "required": "required"}, [])
            HTML.element("label", {}, [HTML.text("Özet metni (yazarak)")])
            HTML.element("textarea", {"name": "body"}, [])
            HTML.element("label", {}, [HTML.text("veya PDF yükle")])
            HTML.element("input", {"type": "file", "name": "paper", "accept": "application/pdf,.pdf"}, [])
            HTML.element("p", {"class": "muted"}, [HTML.text("Yüklenen PDF diskte uzantısız saklanır; indirme adı sizin verdiğiniz özet adı + .pdf olur.")])
            HTML.element("p", {}, [HTML.element("button", {"class": "btn navy", "type": "submit"}, [HTML.text("Özeti kaydet")])])
        ]
    )
    if len(existing) > 0 {
        summaryId: Local String := str(existing[0]["id"].int())
        formOrNote = HTML.element(
            "div"
            {"class": "card"}
            [
                HTML.element("div", {"class": "ok"}, [HTML.text("Özetiniz alındı. Adınız listede bir kez görünür.")])
                HTML.element("h3", {}, [HTML.text(existing[0]["title"].string())])
                HTML.element("p", {}, [
                    HTML.element("a", {"href": "/ozet?id={summaryId}"}, [HTML.text("İndir: " + existing[0]["download_name"].string())])
                ])
            ]
        )
    }

    greeting: Local HTMLNode := HTML.element("p", {}, [HTML.text("Hoş geldiniz, "), HTML.text(userName), HTML.text(".")])
    content: Local HTMLNode := HTML.element(
        "main"
        {}
        [
            HTML.element(
                "div"
                {"class": "wrap"}
                [
                    HTML.element("p", {"class": "kicker"}, [HTML.text("Seminer paneli")])
                    HTML.element("h2", {}, [HTML.text("Panel")])
                    greeting
                    HTML.element(
                        "div"
                        {"class": "card"}
                        [
                            HTML.element("h3", {}, [HTML.text("Katılma sertifikası")])
                            HTML.element("p", {"class": "muted"}, [HTML.text("Sertifika LaTeX ile PDF olarak üretilir. Adınız belgede yer alır.")])
                            HTML.element("p", {}, [HTML.element("a", {"class": "btn navy", "href": "/sertifika"}, [HTML.text("Sertifikayı indir")])])
                        ]
                    )
                    HTML.element("h2", {}, [HTML.text("Özet")])
                    formOrNote
                ]
            )
        ]
    )
    return sessions.commit(session, htmlPage(appTitle, appChrome(session, userName, content), 200))
}

doRegister: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    if csrfOk(session, request) == false {
        return sessions.commit(session, noticePage(session, "CSRF doğrulaması başarısız.", 403))
    }
    usernameValue: Local String? := request.form("username")
    emailValue: Local String? := request.form("email")
    passwordValue: Local String? := request.form("password")
    if usernameValue == null {
        return sessions.commit(session, noticePage(session, "Kullanıcı adı gerekli.", 400))
    }
    if emailValue == null {
        return sessions.commit(session, noticePage(session, "E-posta gerekli.", 400))
    }
    if passwordValue == null {
        return sessions.commit(session, noticePage(session, "Şifre gerekli.", 400))
    }
    usernameText: Local String := usernameValue.trim()
    emailText: Local String := emailValue.trim()
    passwordText: Local String := passwordValue
    if len(usernameText) == 0 {
        return sessions.commit(session, noticePage(session, "Kullanıcı adı boş olamaz.", 400))
    }
    if len(emailText) == 0 {
        return sessions.commit(session, noticePage(session, "E-posta boş olamaz.", 400))
    }
    if len(passwordText) == 0 {
        return sessions.commit(session, noticePage(session, "Şifre boş olamaz.", 400))
    }

    encodedHash: Local String := Security.passwordHash(passwordText)
    db: Local Database := openDb()
    attempt {
        db.execute(
            "INSERT INTO users (username, email, password_hash) VALUES (?, ?, ?)"
            [SQLite.fromString(usernameText), SQLite.fromString(emailText), SQLite.fromString(encodedHash)]
        )
    } except SQLiteError as error {
        db.close()
        return sessions.commit(session, noticePage(session, "Bu kullanıcı adı veya e-posta zaten kayıtlı. Giriş yapmayı deneyin.", 400))
    }
    rows: Local List<Pair<String, SQLiteValue>> := db.query(
        "SELECT id FROM users WHERE username = ?"
        [SQLite.fromString(usernameText)]
    )
    if len(rows) == 0 {
        db.close()
        return sessions.commit(session, noticePage(session, "Kayıt tamamlanamadı.", 400))
    }
    db.close()
    session.rotate()
    session.set("user_id", str(rows[0]["id"].int()))
    rotateCsrf(session)
    return sessions.commit(session, HTTP.redirect("/panel"))
}

doLogin: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    if csrfOk(session, request) == false {
        return sessions.commit(session, noticePage(session, "CSRF doğrulaması başarısız.", 403))
    }
    usernameValue: Local String? := request.form("username")
    passwordValue: Local String? := request.form("password")
    if usernameValue == null {
        return sessions.commit(session, noticePage(session, "Kullanıcı adı gerekli.", 400))
    }
    if passwordValue == null {
        return sessions.commit(session, noticePage(session, "Şifre gerekli.", 400))
    }
    usernameText: Local String := usernameValue.trim()
    passwordText: Local String := passwordValue
    db: Local Database := openDb()
    rows: Local List<Pair<String, SQLiteValue>> := db.query(
        "SELECT id, password_hash FROM users WHERE username = ?"
        [SQLite.fromString(usernameText)]
    )
    if len(rows) == 0 {
        db.close()
        return sessions.commit(session, noticePage(session, "Kayıt bulunamadı.", 400))
    }
    storedHash: Local String := rows[0]["password_hash"].string()
    userId: Local Int := rows[0]["id"].int()
    attempt {
        ok: Local Bool := Security.passwordVerify(passwordText, storedHash)
        if ok == false {
            db.close()
            return sessions.commit(session, noticePage(session, "Şifre uyuşmuyor.", 400))
        }
    } except SecurityError as error {
        db.close()
        return sessions.commit(session, noticePage(session, "Kayıtlı şifre hash'i bozuk.", 400))
    }
    db.close()
    session.rotate()
    session.set("user_id", str(userId))
    rotateCsrf(session)
    return sessions.commit(session, HTTP.redirect("/panel"))
}

doForgot: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    if csrfOk(session, request) == false {
        return sessions.commit(session, noticePage(session, "CSRF doğrulaması başarısız.", 403))
    }
    accountValue: Local String? := request.form("account")
    if accountValue == null {
        return sessions.commit(session, noticePage(session, "Kullanıcı adı veya e-posta gerekli.", 400))
    }
    accountText: Local String := accountValue.trim()
    if len(accountText) == 0 {
        return sessions.commit(session, noticePage(session, "Kullanıcı adı veya e-posta boş olamaz.", 400))
    }
    db: Local Database := openDb()
    rows: Local List<Pair<String, SQLiteValue>> := db.query(
        "SELECT id, email FROM users WHERE username = ? OR email = ?"
        [SQLite.fromString(accountText), SQLite.fromString(accountText)]
    )
    if len(rows) > 0 {
        userId: Local Int := rows[0]["id"].int()
        emailText: Local String := rows[0]["email"].string()
        resetToken: Local String := Security.token()
        tokenHash: Local String := Security.passwordHash(resetToken)
        db.execute("DELETE FROM password_resets WHERE user_id = ?", [SQLite.fromInt(userId)])
        db.execute(
            "INSERT INTO password_resets (user_id, token_hash) VALUES (?, ?)"
            [SQLite.fromInt(userId), SQLite.fromString(tokenHash)]
        )
        mailResult: Local String := sendResetMail(emailText, resetToken)
        if mailResult != "ok" {
            write("SMTP sıfırlama postası gönderilemedi: " + mailResult)
        }
    }
    db.close()
    rotateCsrf(session)
    return sessions.commit(session, noticePage(session, "Bu kullanıcı adı veya e-posta kayıtlıysa sıfırlama bağlantısı gönderildi.", 200))
}

doReset: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    if csrfOk(session, request) == false {
        return sessions.commit(session, noticePage(session, "CSRF doğrulaması başarısız.", 403))
    }
    tokenValue: Local String? := request.form("token")
    passwordValue: Local String? := request.form("password")
    if tokenValue == null {
        return sessions.commit(session, noticePage(session, "Sıfırlama bağlantısı eksik.", 400))
    }
    if passwordValue == null {
        return sessions.commit(session, noticePage(session, "Şifre gerekli.", 400))
    }
    passwordText: Local String := passwordValue
    candidateToken: Local String := tokenValue
    if len(passwordText) == 0 {
        return sessions.commit(session, noticePage(session, "Şifre boş olamaz.", 400))
    }
    db: Local Database := openDb()
    rows: Local List<Pair<String, SQLiteValue>> := db.query("SELECT user_id, token_hash FROM password_resets")
    matchedId: Local Int := 0
    found: Local Bool := false
    for row in rows {
        storedHash: Local String := row["token_hash"].string()
        attempt {
            ok: Local Bool := Security.passwordVerify(candidateToken, storedHash)
            if ok == true {
                matchedId = row["user_id"].int()
                found = true
            }
        } except SecurityError as error {
            found = found
        }
    }
    if found == false {
        db.close()
        return sessions.commit(session, noticePage(session, "Sıfırlama bağlantısı geçersiz.", 400))
    }
    encodedHash: Local String := Security.passwordHash(passwordText)
    db.execute(
        "UPDATE users SET password_hash = ? WHERE id = ?"
        [SQLite.fromString(encodedHash), SQLite.fromInt(matchedId)]
    )
    db.execute("DELETE FROM password_resets WHERE user_id = ?", [SQLite.fromInt(matchedId)])
    db.close()
    rotateCsrf(session)
    return sessions.commit(session, noticePage(session, "Şifreniz güncellendi. Giriş yapabilirsiniz.", 200))
}

saveSummary: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    uploadDir: Global String
    session: Local Session := sessions.open(request)
    if csrfOk(session, request) == false {
        return sessions.commit(session, noticePage(session, "CSRF doğrulaması başarısız.", 403))
    }
    titleValue: Local String? := request.form("title")
    bodyValue: Local String? := request.form("body")
    paper: Local UploadedFile? := request.file("paper")
    if titleValue == null {
        return sessions.commit(session, noticePage(session, "Özet adı gerekli.", 400))
    }
    titleText: Local String := titleValue.trim()
    if len(titleText) == 0 {
        return sessions.commit(session, noticePage(session, "Özet adı boş olamaz.", 400))
    }
    bodyText: Local String := ""
    if bodyValue != null {
        bodyText = bodyValue.trim()
    }

    db: Local Database := openDb()
    userId: Local Int? := loggedId(session)
    if userId == null {
        db.close()
        return sessions.commit(session, HTTP.redirect("/giris"))
    }
    existing: Local List<Pair<String, SQLiteValue>> := db.query(
        "SELECT id FROM summaries WHERE user_id = ?"
        [SQLite.fromInt(userId)]
    )
    if len(existing) > 0 {
        db.close()
        return sessions.commit(session, noticePage(session, "Özetiniz zaten alınmıştı.", 400))
    }

    storedPath: Local String := ""
    contentType: Local String := ""
    downloadName: Local String := ""
    if paper != null {
        if paper.detectedContentType() != "application/pdf" {
            db.close()
            return sessions.commit(session, noticePage(session, "Yalnızca PDF kabul edilir.", 415))
        }
        ensureDir(uploadDir)
        storedPath = paper.save(uploadDir)
        contentType = "application/pdf"
        downloadName = titleText + ".pdf"
    }
    else {
        if len(bodyText) == 0 {
            db.close()
            return sessions.commit(session, noticePage(session, "Özet metni yazın veya PDF yükleyin.", 400))
        }
        ensureDir(uploadDir)
        storedPath = Path.join([uploadDir, Security.token()])
        File.writeText(storedPath, bodyText)
        contentType = "text/plain; charset=utf-8"
        downloadName = titleText + ".txt"
    }

    db.execute(
        "INSERT INTO summaries (user_id, title, stored_path, content_type, download_name) VALUES (?, ?, ?, ?, ?)"
        [
            SQLite.fromInt(userId)
            SQLite.fromString(titleText)
            SQLite.fromString(storedPath)
            SQLite.fromString(contentType)
            SQLite.fromString(downloadName)
        ]
    )
    db.close()
    rotateCsrf(session)
    return sessions.commit(session, HTTP.redirect("/"))
}

downloadSummary: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    idText: Local String? := request.query("id")
    if idText == null {
        return sessions.commit(session, noticePage(session, "Özet numarası gerekli.", 400))
    }
    db: Local Database := openDb()
    rows: Local List<Pair<String, SQLiteValue>> := db.query(
        "SELECT stored_path, content_type, download_name FROM summaries WHERE id = ?"
        [SQLite.fromInt(int(idText))]
    )
    db.close()
    if len(rows) == 0 {
        return sessions.commit(session, noticePage(session, "Özet bulunamadı.", 404))
    }
    storedPath: Local String := rows[0]["stored_path"].string()
    contentType: Local String := rows[0]["content_type"].string()
    downloadName: Local String := rows[0]["download_name"].string()
    return sessions.commit(session, HTTP.download(storedPath, contentType, downloadName))
}

doLogout: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    if csrfOk(session, request) == false {
        return sessions.commit(session, noticePage(session, "CSRF doğrulaması başarısız.", 403))
    }
    session.destroy()
    return sessions.commit(session, HTTP.redirect("/"))
}

downloadCertificate: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    certDir: Global String
    session: Local Session := sessions.open(request)
    db: Local Database := openDb()
    userName: Local String? := loggedName(db, session)
    db.close()
    if userName == null {
        return sessions.commit(session, HTTP.redirect("/giris"))
    }
    escapedName: Local String := Latex.escape(userName)
    body: Local String := Latex.center("AHD Akademi · Hatay 2026")
    body += Latex.section("Katılma Sertifikası")
    body += "Bu belge, " + escapedName + " adlı katılımcının 27--30 Eylül 2026 tarihlerinde Hatay'da düzenlenen AHD Matematik ve Kodlama Semineri'ne katıldığını belgeler.\n"
    body += Latex.section("Düzenleyen")
    body += "Mustafa Kemal Üniversitesi · AHD Akademi\n"
    source: Local String := Latex.document(
        body: body
        title: "Katılma Sertifikası"
        author: escapedName
        date: "27-30 Eylül 2026"
        type: "Article"
        margin: 2.5
        color: "#122033"
    )
    ensureDir(certDir)
    storedPath: Local String := Path.join([certDir, Security.token() + ".pdf"])
    attempt {
        Latex.pdf(source, storedPath)
    } except LatexError as error {
        return sessions.commit(session, noticePage(session, "Sertifika üretilemedi: " + error.message, 500))
    }
    downloadName: Local String := userName + " - Katilma Sertifikasi.pdf"
    return sessions.commit(session, HTTP.download(storedPath, "application/pdf", downloadName))
}

app: Server := HTTP.server(appHost, appPort, 26214400)
app.get("/", home)
app.get("/kayit", registerPage)
app.get("/giris", loginPage)
app.get("/panel", panelPage)
app.get("/sifre-unuttum", forgotPage)
app.get("/sifre-sifirla", resetPage)
app.get("/ozet", downloadSummary)
app.get("/sertifika", downloadCertificate)
app.post("/kayit", doRegister)
app.post("/giris", doLogin)
app.post("/cikis", doLogout)
app.post("/ozet", saveSummary)
app.post("/sifre-unuttum", doForgot)
app.post("/sifre-sifirla", doReset)
write("Seminer: http://{appHost}:{str(appPort)}/")
app.start()
